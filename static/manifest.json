{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "2.4.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-translate@willlllliams.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-16.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_action": {
    "default_popup": "subjects.html",
    "default_title": "__MSG_subjectsTitle__",
    "default_icon": { "16": "icons/icon-16.svg", "32": "icons/icon-16.svg" }
  },
  "message_display_action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon-16.svg", "32": "icons/icon-16.svg" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Alt+A" },
      "description": "__MSG_commandToggle__"
    },
    "toggle-display-mode": {
      "suggested_key": { "default": "Alt+S" },
      "description": "__MSG_commandMode__"
    },
    "retranslate": {
      "suggested_key": { "default": "Alt+R" },
      "description": "__MSG_commandRetranslate__"
    },
    "summarize": {
      "description": "__MSG_commandSummarize__"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesModify",
    "messagesRead",
    "sensitiveDataUpload",
    "storage",
    "unlimitedStorage",
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://fanyi-api.baidu.com/*",
    "https://openapi.youdao.com/*",
    "https://api.interpreter.caiyunai.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://openrouter.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://api.deepinfra.com/*",
    "https://api.cerebras.ai/*",
    "https://api.perplexity.ai/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.siliconflow.cn/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://firefox.settings.services.mozilla.com/*",
    "https://firefox-settings-attachments.cdn.mozilla.net/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
