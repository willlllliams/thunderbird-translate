{
  "name": "thunderbird-translate",
  "version": "2.0.0",
  "private": true,
  "description": "Thunderbird MailExtension that translates email bodies in place (bilingual or translation-only), with free translators and 20+ AI providers.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "live-test": "node scripts/live-test.mjs",
    "locales:check": "node scripts/locales.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "imports:check": "node scripts/check-imports.mjs",
    "fetch:bergamot": "node scripts/fetch-bergamot.mjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/run.mjs",
    "source-zip": "node scripts/source-zip.mjs"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.65",
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/azure": "^4.0.99",
    "@ai-sdk/cerebras": "^3.0.67",
    "@ai-sdk/deepinfra": "^3.0.67",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/fireworks": "^3.0.70",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/mistral": "^4.0.62",
    "@ai-sdk/moonshotai": "^3.0.67",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/perplexity": "^5.0.10",
    "@ai-sdk/togetherai": "^3.0.68",
    "@ai-sdk/xai": "^5.0.20",
    "ai": "^7.0.137",
    "fzstd": "^0.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
